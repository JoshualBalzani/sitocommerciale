---
import { ArrowUpRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import { home } from '../data/content';
import { areaImagery } from '../data/imagery';
---
<section class="section area-entry" id="aree-prodotto" aria-labelledby="area-entry-title"><div class="container">
  <div class="section-heading"><div><p class="eyebrow">01 / Le soluzioni</p><h2 id="area-entry-title">Ogni impianto.<br /><em>La sua soluzione.</em></h2></div><p>Dai sistemi per il comfort ai componenti per l’impianto. Esplora l’area di interesse e individua i prodotti da indicare nella richiesta.</p></div>
  <div class="area-grid">{home.areas.map(area => <a class="area-product-card" href={`/${area.slug}/`}><div class="area-photo"><Image src={areaImagery(area.slug).image} alt="" widths={[400,640,960,1400]} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1480px) calc((92vw - 20px) / 2), 670px" format="webp" quality={78} loading="lazy" decoding="async" /></div><div class="area-card-content"><div class="area-card-heading"><span class="area-index">{area.number} /</span><span class="area-arrow"><ArrowUpRight size={22} aria-hidden="true" /></span></div><h3>{area.name}</h3><p>{area.description}</p><span class="area-card-bottom">Prodotti e informazioni <ArrowUpRight size={17} aria-hidden="true" /></span></div></a>)}</div>
  <p class="area-image-note">Ambientazioni illustrative generate con IA.</p>
</div></section>
