---
import { home } from '../data/content';
import { catalogue } from '../data/catalogue';
import { requestCategories } from '../data/site';
import { Search, X, ArrowUpRight } from '@lucide/astro';
const categories = requestCategories.slice(0,4);
---
<section class="section" id="prodotti" aria-labelledby="catalog-title"><div class="container">
  <div class="section-heading"><div><p class="eyebrow">02 / Catalogo prodotti</p><h2 id="catalog-title">Trova la categoria.<br /><em>Prepara la richiesta.</em></h2></div><p>Cerca un prodotto o un’esigenza, esplora le categorie e seleziona il riferimento da inviarci. Non è necessario conoscere già il codice.</p></div>
  <div class="catalogue-full-link"><div><strong>Tutte le gamme, in un unico catalogo.</strong><p>{catalogue.length} famiglie di prodotto dei nove marchi, filtrabili per marchio e applicazione.</p></div><a class="button" href="/catalogo/">Apri il catalogo completo</a></div>
  <div id="catalogo-completo">
    <div class="catalog-tools" data-catalog-tools hidden>
      <div class="catalog-search"><label for="catalog-search">Quale prodotto cerchi?</label><div class="catalog-search-field"><Search size={20} aria-hidden="true" /><input id="catalog-search" type="search" placeholder="Es. clima, rubinetti, VMC o un marchio…" autocomplete="off" aria-controls="catalog-grid" aria-describedby="catalog-search-help" /><button type="button" data-clear-catalog-search aria-label="Cancella la ricerca" hidden><X size={18} aria-hidden="true" /></button></div><p id="catalog-search-help">Puoi combinare più termini, anche in ordine diverso.</p></div>
      <div class="catalog-filter-heading"><span>Esplora per area</span><p id="catalog-count" role="status" aria-live="polite">10 categorie</p></div>
      <div class="catalog-filters" role="group" aria-label="Filtra per categoria"><button type="button" data-filter="all" aria-pressed="true">Tutte <span data-filter-count aria-hidden="true">10</span></button>{categories.map(category => <button type="button" data-filter={category} aria-pressed="false">{category} <span data-filter-count aria-hidden="true">{home.catalog.filter(item=>item.category===category).length}</span></button>)}</div>
      <div class="catalog-results"><p class="catalog-hint">Area selezionata: <strong data-active-catalog-area>Tutte le aree</strong><span data-active-catalog-query></span></p><button type="button" class="text-button" data-reset-catalog>Azzera filtri</button></div>
    </div>
    <div id="catalog-grid" class="catalog-grid">{home.catalog.map((item,index) => <article class="catalog-card" id={item.id} data-category={item.category} data-search={[item.title,item.category,item.description,item.hint,...item.includes,...item.aliases,...item.brands].join(' ')}>
      <div class="catalog-card-top"><span>{item.category}</span><span>{String(index+1).padStart(2,'0')}</span></div>
      <h3>{item.title}</h3><p class="catalog-description">{item.description}</p>
      <a class="button catalog-request" href="#richiesta" data-request-category={item.category} data-request-product={item.product} data-request-type="Informazioni">Richiedi informazioni su questa categoria<span class="visually-hidden">: {item.title}</span></a>
      <details><summary>Dettagli per la richiesta</summary><div class="catalog-detail-content"><div><h4>La categoria comprende</h4><ul>{item.includes.map(entry => <li>{entry}</li>)}</ul></div><div><h4>Informazioni utili da indicare</h4><p>{item.hint}</p>{item.brands.length>0 && <div class="catalog-brand-options"><span>Marchio rappresentato</span>{item.brands.map(value => <a href="#richiesta" data-request-category={item.category} data-request-product={item.product} data-request-brand={value} data-request-type="Informazioni">{home.brands.find(brand=>brand.value===value)?.name}<ArrowUpRight size={14} aria-hidden="true" /><span class="visually-hidden"> · Richiedi informazioni su {item.title}</span></a>)}</div>}</div></div></details>
    </article>)}</div>
    <div class="catalog-empty" hidden><h3>Nessuna categoria trovata.</h3><p>Prova un termine più generale o cambia area. Se il prodotto non compare, puoi comunque descriverlo nella richiesta.</p><div class="catalog-empty-actions"><button type="button" class="button button-secondary" data-reset-catalog>Mostra tutte le categorie</button><a class="text-link" href="#richiesta" data-catalog-missing-request data-request-category="Richiesta di orientamento" data-request-product="" data-request-type="Informazioni">Richiedi un prodotto non presente</a></div></div>
    <p class="editorial-note">Il catalogo presenta categorie di prodotto. Modelli, disponibilità e condizioni di fornitura vengono verificati per la singola richiesta.</p>
  </div>
</div></section>
<script>import '../scripts/catalog';</script>
