---
import BaseLayout from '../layouts/BaseLayout.astro';
import { areas, requestUrl, type Area } from '../data/content';
import { company } from '../data/site';
import FlowMark from './FlowMark.astro';
import { Image } from 'astro:assets';
import { areaImagery } from '../data/imagery';
interface Props { area: Area; content: string; }
const { area, content } = Astro.props;
const visual = areaImagery(area.slug);
---
<BaseLayout title={area.title} description={area.description} bodyClass="page-area">
  <main id="contenuto" class="seo-area-page" tabindex="-1">
    <div class="area-signature container"><FlowMark /><span>{area.name} / Commerciale Clima Plus</span></div>
    <section class="section area-hero seo-area-hero"><div class="container"><nav class="breadcrumbs seo-breadcrumbs" aria-label="Percorso"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{area.name}</span></nav><p class="eyebrow">Rappresentanze e forniture · Forlì</p><div class="area-hero-grid"><div><h1>{area.heroTitle}</h1><p class="lead">{area.lead}</p><div class="hero-actions"><a class="button" href={requestUrl(area.name)}>Richiedi informazioni</a><a class="text-link" href={`tel:${company.telephone}`}>{company.phone}</a></div></div><figure class="area-hero-photo"><Image src={visual.image} alt={visual.alt} widths={[480,800,1200,1600]} sizes="(max-width: 959px) calc(100vw - 40px), (max-width: 1480px) 32vw, 440px" format="webp" quality={82} loading="eager" fetchpriority="high" decoding="async" /><figcaption>Ambientazione illustrativa generata con IA.</figcaption></figure></div><nav class="seo-area-nav" aria-label="Aree di prodotto">{areas.map(item=><a href={`/${item.slug}/`} aria-current={area.slug === item.slug ? 'page' : undefined}>{item.name}</a>)}</nav></div></section>
    <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">L’area di prodotto</p><h2>{area.introTitle}</h2></div><p>{area.intro}</p></div><div class="seo-area-cards">{area.products.map((product,index)=><article class="editorial-item"><span class="eyebrow">0{index+1}</span><h3>{product.title}</h3><p>{product.description}</p><a class="text-link" href={requestUrl(area.name,product.title)}>Richiedi informazioni sul prodotto</a></article>)}</div></div></section>
    <Fragment set:html={content} />
  </main>
</BaseLayout>
