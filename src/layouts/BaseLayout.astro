---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrivacyNotice from '../components/PrivacyNotice.astro';
import { company, policy, siteUrl, verification } from '../data/site';
import '../styles/global.css';
import '../styles/design.css';
interface Props { title: string; description: string; noindex?: boolean; bodyClass?: string; }
const { title, description, noindex = false, bodyClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, siteUrl).href;
const structured = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'LocalBusiness', '@id': `${siteUrl}/#azienda`, name: company.name, legalName: company.legalName, url: `${siteUrl}/`, taxID: company.vat, vatID: `IT${company.vat}`, telephone: company.telephone, email: company.email,
      image: `${siteUrl}/logo-large.png`, logo: `${siteUrl}/logo.png`,
      address: { '@type': 'PostalAddress', streetAddress: company.street, addressLocality: company.city, addressRegion: company.province, postalCode: company.postalCode, addressCountry: 'IT' },
      openingHoursSpecification: [['08:30', '12:30'], ['14:00', '17:00']].map(([opens, closes]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens, closes })) },
    { '@type': 'WebSite', '@id': `${siteUrl}/#sito`, url: `${siteUrl}/`, name: company.name, inLanguage: 'it-IT' },
    { '@type': 'WebPage', '@id': `${canonical}#pagina`, url: canonical, name: title, description, inLanguage: 'it-IT', isPartOf: { '@id': `${siteUrl}/#sito` }, about: { '@id': `${siteUrl}/#azienda` } },
    ...(Astro.url.pathname !== '/' && !noindex ? [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` }, { '@type': 'ListItem', position: 2, name: title.split('|')[0]?.trim(), item: canonical }] }] : []),
  ],
};
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={policy} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0d47a1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/logo-large.png`} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/logo-large.png`} />
    {verification && <meta name="google-site-verification" content={verification} />}
    <script type="application/ld+json" set:html={JSON.stringify(structured).replaceAll('<', '\u003c')} />
  </head>
  <body class={bodyClass} id="inizio">
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <Header />
    <slot />
    <Footer />
    <PrivacyNotice />
    <script>import '../scripts/motion';</script>
    <script>import '../scripts/scroll';</script>
  </body>
</html>
