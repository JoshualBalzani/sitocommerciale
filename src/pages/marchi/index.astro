---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandDirectory from '../../components/BrandDirectory.astro';
import { Image } from 'astro:assets';
import { brandImagery } from '../../data/brand-imagery';
const visual = brandImagery('materiali');
const secondary = brandImagery('impianto');
---
<BaseLayout title="Marchi rappresentati a Forlì, Ravenna, Rimini e Bologna | Clima Plus" description="Nove marchi per riscaldamento, climatizzazione, ventilazione e termoidraulica. Rappresentanze commerciali nelle province di Forlì-Cesena, Ravenna, Rimini e Bologna.">
  <main id="contenuto" tabindex="-1"><section class="section brand-page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Percorso"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Marchi</span></nav><div class="brand-hero-grid"><div><p class="eyebrow">Le rappresentanze commerciali</p><h1>Nove marchi.<span>Competenze complementari per il comfort.</span></h1><p class="lead">Siamo agenti di commercio di tutti i marchi presentati. Un riferimento a Forlì per le richieste di installatori, rivenditori, professionisti e aziende nelle province di Forlì-Cesena, Ravenna, Rimini e Bologna.</p><div class="hero-actions"><a class="button" href="#rappresentanze">Esplora i marchi</a><a class="text-link" href="/zone-servite/">Le zone servite</a></div></div><figure class="brand-photo"><Image src={visual.image} alt={visual.alt} widths={[480,800,1200,1600]} sizes="(max-width: 959px) calc(100vw - 40px), 45vw" format="webp" loading="eager" fetchpriority="high" /><figcaption>Immagine illustrativa generata con IA.</figcaption></figure></div></div></section>
    <section class="section" id="rappresentanze"><div class="container"><div class="section-heading"><div><p class="eyebrow">Dai sistemi ai componenti</p><h2>Le gamme rappresentate.</h2></div><p>Ogni pagina raccoglie le famiglie di prodotto del marchio e consente di inviare una richiesta mirata. La disponibilità dei singoli articoli viene verificata in fase commerciale.</p></div><BrandDirectory /></div></section>
    <section class="section brand-context"><div class="container brand-context-grid"><figure class="brand-photo"><Image src={secondary.image} alt={secondary.alt} widths={[480,800,1200]} sizes="(max-width: 959px) calc(100vw - 40px), 42vw" format="webp" loading="lazy" /><figcaption>Ambientazione illustrativa generata con IA.</figcaption></figure><div><p class="eyebrow">La nostra attività</p><h2>La rappresentanza, con un contatto diretto.</h2><p>Raccogliamo le esigenze e organizziamo le richieste sui prodotti dei nove marchi. Puoi partire da una famiglia di prodotto, da un ambito applicativo o dal marchio di tuo interesse.</p><a class="button" href="/#richiesta">Richiedi informazioni</a></div></div></section>
  </main>
</BaseLayout>
