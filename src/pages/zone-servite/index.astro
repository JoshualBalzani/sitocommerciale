---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandDirectory from '../../components/BrandDirectory.astro';
import { provinces } from '../../data/brands';
import { company } from '../../data/site';
import { brandImagery } from '../../data/brand-imagery';
import { Image } from 'astro:assets';
const visual = brandImagery('panorama');
const secondary = brandImagery('componenti');
---
<BaseLayout title="Rappresentanze a Forlì-Cesena, Ravenna, Rimini e Bologna | Clima Plus" description="Commerciale Clima Plus: agenti di commercio di nove marchi nelle province di Forlì-Cesena, Ravenna, Rimini e Bologna. Sede e contatto commerciale a Forlì.">
  <main id="contenuto" tabindex="-1"><section class="section brand-page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Percorso"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Zone servite</span></nav><div class="brand-hero-grid"><div><p class="eyebrow">Il territorio</p><h1>Dalla Romagna a Bologna.<span>Un riferimento commerciale vicino al tuo lavoro.</span></h1><p class="lead">Operiamo come agenti di commercio di tutti i nove marchi rappresentati nelle province di Forlì-Cesena, Ravenna, Rimini e Bologna. La nostra sede è a Forlì, in {company.street}.</p><div class="hero-actions"><a class="button" href="/#richiesta">Invia una richiesta commerciale</a><a class="text-link" href={`tel:${company.telephone}`}>{company.phone}</a></div></div><figure class="brand-photo"><Image src={visual.image} alt={visual.alt} widths={[480,800,1200,1600]} sizes="(max-width: 959px) calc(100vw - 40px), 45vw" format="webp" loading="eager" fetchpriority="high" /><figcaption>Ambientazione illustrativa generata con IA.</figcaption></figure></div></div></section>
    <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Quattro province, tutte le rappresentanze</p><h2>La copertura commerciale.</h2></div><p>Installatori, rivenditori, studi professionali e aziende possono rivolgersi allo stesso contatto per informazioni sulle gamme e richieste di fornitura.</p></div><ul class="province-grid">{provinces.map((name,index) => <li><span class="eyebrow">0{index+1} / Provincia</span><h3>{name}</h3><p>Tutti i nove marchi rappresentati.</p></li>)}</ul><p class="editorial-note">Le province indicano l’area di attività commerciale. L’unica sede aziendale indicata sul sito è quella di Forlì; non sono presenti sedi locali nelle altre province.</p></div></section>
    <section class="section brand-context"><div class="container brand-context-grid"><figure class="brand-photo"><Image src={secondary.image} alt={secondary.alt} widths={[480,800,1200]} sizes="(max-width: 959px) calc(100vw - 40px), 42vw" format="webp" loading="lazy" /><figcaption>Immagine illustrativa generata con IA.</figcaption></figure><div><p class="eyebrow">Come richiedere informazioni</p><h2>Indica il contesto. Organizziamo la richiesta.</h2><p>Nel messaggio puoi specificare il comune o la provincia, il marchio e la famiglia di prodotto di interesse. Questi elementi aiutano a inquadrare le esigenze commerciali.</p><p>La nostra attività è di rappresentanza commerciale. Per installazione, manutenzione e assistenza tecnica occorre rivolgersi al professionista o al servizio competente.</p><a class="button" href="/#richiesta">Contatta Commerciale Clima Plus</a><p class="brand-office">{company.legalName}<br />{company.street}, {company.postalCode} {company.city} ({company.province})</p></div></div></section>
    <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">I marchi nel territorio</p><h2>Esplora le rappresentanze.</h2></div><p>La copertura delle quattro province si applica a ciascuno dei marchi elencati.</p></div><BrandDirectory /></div></section>
  </main>
</BaseLayout>
